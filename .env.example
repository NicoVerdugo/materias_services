# Copiar este archivo como .env y cambiar los valores.
# .env NO se sube a git (ya está en .gitignore).
DB_USER=materias_user
DB_PASSWORD=cambiame123
DB_NAME=materias_db

# AWS S3 (contenido temático en PDF). Obligatorias: el servicio no arranca sin ellas.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
# Solo con credenciales temporales (AWS Academy / STS); si no aplica, dejar vacío
AWS_SESSION_TOKEN=
